# Server & Runtime Configuration
PORT=3000
NODE_ENV=development

# Authentication
JWT_SECRET=pwoa_secure_jwt_token_secret_production_2026

# Google Gemini AI Integration
# Required for contextual task prioritization reasoning and AI assistant
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Database Configuration (PostgreSQL)
# For local development with PGlite, directory path:
DATABASE_PATH=./data/pwoa_postgres

# For external PostgreSQL / Neon deployment:
# DATABASE_URL=postgresql://user:password@host:5432/pwoa_db
